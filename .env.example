# ============================================================================
# LeadSynt — environment configuration (copy to .env and adjust per profile)
# NEVER commit real secrets. Every value here is a template.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
LEADSynt_APP_NAME="LeadSynt"
LEADSynt_ENVIRONMENT=dev                # dev | staging | production
LEADSynt_DEBUG=true
LEADSynt_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LEADSynt_LOG_JSON=true
LEADSynt_SECRET_KEY=change-me-to-a-long-random-secret-of-at-least-64-bytes-in-production
LEADSynt_FRONTEND_URL=http://localhost:3000
LEADSynt_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEADSynt_API_V1_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# DATABASE  (target: Microsoft SQL Server; dev profile may use SQLite)
# ----------------------------------------------------------------------------
# SQL Server (production / docker-compose):
# LEADSynt_DATABASE_URL=mssql+pyodbc://sa:Change%21Me@leadsynt-db:1433/LeadSynt?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# SQLite (local dev only — not for production):
LEADSynt_DATABASE_URL=sqlite:///./leadsynt_dev.db
LEADSynt_DB_ECHO=false
LEADSynt_DB_POOL_SIZE=10
LEADSynt_DB_POOL_RECYCLE_SECONDS=1800
LEADSynt_DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------------
# REDIS (queue broker, cache, pub/sub events)
# ----------------------------------------------------------------------------
LEADSynt_REDIS_URL=redis://localhost:6379/0
LEADSynt_REDIS_DB=0
# true  = use Redis broker + real Celery worker (compose/production)
# false = tasks execute in-process (dev without a running worker)
LEADSynt_CELERY_TASK_ALWAYS_EAGER=false
LEADSynt_CELERY_BROKER_URL=redis://localhost:6379/1
LEADSynt_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
LEADSynt_JWT_ALGORITHM=HS256
LEADSynt_JWT_ISSUER=leadsynt
LEADSynt_JWT_ACCESS_TOKEN_TTL_MINUTES=60
LEADSynt_JWT_REFRESH_TOKEN_TTL_DAYS=7
LEADSynt_ALLOW_SELF_REGISTRATION=true   # set false in production
LEADSynt_DEFAULT_REGISTRATION_ROLE=viewer
LEADSynt_SEED_ADMIN_EMAIL=admin@leadsynt.io
LEADSynt_SEED_ADMIN_PASSWORD=LeadSynt-Dev-Only-2026
LEADSynt_BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# AI (Phase A implemented: providers/models catalog, deterministic + optional
# LLM-backed agents, budget caps, per-agent dashboards, run API)
# ----------------------------------------------------------------------------
# Provider id for LLM-backed agent runs: "none" | "openai" | "anthropic"
# (catalog is seeded at startup; provider/model ids resolve to it)
LEADSynt_AI_PROVIDER=none
LEADSynt_AI_API_KEY=
LEADSynt_AI_MODEL=
LEADSynt_AI_MAX_COST_PER_RUN_USD=0.05
LEADSynt_AI_MAX_TOKENS_PER_RUN=4000
# Default monthly budget per agent, USD (0 = unlimited); enforced on every run
LEADSynt_AI_DEFAULT_MONTHLY_BUDGET_USD=0
# Timeout for LLM chat-completion calls, seconds
LEADSynt_AI_LLM_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------------
# EMAIL / SMS (interfaces exist; providers wired in a later phase)
# ----------------------------------------------------------------------------
LEADSynt_EMAIL_SMTP_HOST=
LEADSynt_EMAIL_SMTP_PORT=587
LEADSynt_EMAIL_FROM=notifications@leadsynt.io
LEADSynt_SMS_PROVIDER=none
LEADSynt_SMS_API_KEY=

# ----------------------------------------------------------------------------
# OUTREACH (Phase B — outreach engine)
# ----------------------------------------------------------------------------
# Email transport: "log" (default) records outbound attempts to the outbound
# log WITHOUT claiming external delivery; "smtp" performs real delivery via
# the SMTP settings above. Every send is gated live by suppression, consent,
# the reply/handover pause, the per-contact daily cap and quiet hours.
LEADSynt_OUTREACH_EMAIL_TRANSPORT=log
LEADSynt_OUTREACH_EMAIL_FROM=outreach@leadsynt.io
LEADSynt_OUTREACH_SENDER_NAME=LeadSynt
# Outreach guardrails (also configurable in /api/v1/settings under "outreach"):
#   max_daily_per_contact = per-contact daily send cap (0 = unlimited)
#   quiet_hours = {"start": "20:00", "end": "09:00"} + quiet_hours_enabled
#   require_suppression_check = true (mandatory; cannot be disabled)

# ----------------------------------------------------------------------------
# VERIFICATION
# ----------------------------------------------------------------------------
LEADSynt_VERIFICATION_EMAIL_PROVIDER=none    # none | mailgun | sendgrid | ...
LEADSynt_VERIFICATION_PHONE_PROVIDER=none    # none | twilio | ...

# ----------------------------------------------------------------------------
# STORAGE (document / dossier storage; later phase)
# ----------------------------------------------------------------------------
LEADSynt_STORAGE_BACKEND=local
LEADSynt_STORAGE_LOCAL_PATH=./storage

# ----------------------------------------------------------------------------
# WEBHOOKS
# ----------------------------------------------------------------------------
# Shared secret used to HMAC-sign outbound webhooks AND verify inbound
# reply/inbox webhooks (see docs/security.md)
LEADSynt_WEBHOOK_SHARED_SECRET=change-me-webhook-secret
LEADSynt_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# ----------------------------------------------------------------------------
# NOTIFICATIONS
# ----------------------------------------------------------------------------
LEADSynt_NOTIFICATIONS_IN_APP=true
LEADSynt_NOTIFICATIONS_EMAIL=false
LEADSynt_NOTIFICATIONS_SMS=false

# ----------------------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------------------
LEADSynt_METRICS_ENABLED=true
LEADSynt_QA_STALE_TICKET_HOURS=72
LEADSynt_RATE_LIMIT_REQUESTS_PER_MINUTE=300
